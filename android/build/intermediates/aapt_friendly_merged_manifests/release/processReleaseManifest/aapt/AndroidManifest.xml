<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.capacitor.mediastore" >

    <uses-sdk android:minSdkVersion="23" />

    <!-- Required permissions for media access -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Granular media permissions for Android 13+ — AUDIO ONLY -->
    <!-- READ_MEDIA_IMAGES and READ_MEDIA_VIDEO removed per Google Play policy -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Media Session: Foreground service permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Notification permission for Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Internet for loading artwork from URL -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Query for media apps (Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />

            <data android:mimeType="audio/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />

            <data android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />

            <data android:mimeType="image/*" />
        </intent>
    </queries>

    <application>

        <!-- Plugin registration will be handled by Capacitor -->


        <!-- Media Session Foreground Service -->
        <service
            android:name="com.capacitor.mediastore.MediaSessionService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" >
        </service>
    </application>

</manifest>